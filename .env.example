# Copy to .env and fill in. .env is gitignored.
# Provider is intentionally not hardcoded; pick one Qwen3-8B endpoint and one mini-class reflection model.

# Task model: Qwen3-8B via a LiteLLM-style model string.
# Examples:
#   together_ai/Qwen/Qwen3-8B
#   fireworks_ai/accounts/fireworks/models/qwen3-8b
#   deepinfra/Qwen/Qwen3-8B
#   openai/Qwen3-8B          (with a custom base URL, e.g. local vLLM)
TASK_MODEL=
TASK_MODEL_API_KEY=
# Only set if your provider needs a custom base URL (e.g. local vLLM at http://localhost:8000/v1).
TASK_MODEL_BASE_URL=

# Reflection model: mini-class, held constant across all arms.
# Examples: openai/gpt-4o-mini, openai/gpt-4.1-mini
REFLECTION_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=

# Provider-specific keys (set only the one(s) you use).
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPINFRA_API_KEY=
